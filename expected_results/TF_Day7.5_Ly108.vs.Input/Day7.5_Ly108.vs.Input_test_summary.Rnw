targetgenelist=c("Ezh2","Zbtb7a","Wt1","Zbtb17","Mybl2","Bcl6","Bcl11b","Yy1","Zc3h8","Srf")
# samplelabel=sub('.\w+.\w+$','',colnames(gstable)[startindex]);
samplelabel='Day7.5_Ly108_1,Day7.5_Ly108_2_vs_Input_1,Input_2 neg.'


# You need to write some codes in front of this code:
