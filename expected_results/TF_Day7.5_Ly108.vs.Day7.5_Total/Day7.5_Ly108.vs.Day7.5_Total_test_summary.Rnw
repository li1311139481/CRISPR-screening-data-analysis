targetgenelist=c("Fli1","Mnt","Hoxa10","Tcf7l2","Nfatc3","Tgif1","Bcl6","Epas1","Tcf12","Irf7")
# samplelabel=sub('.\w+.\w+$','',colnames(gstable)[startindex]);
samplelabel='Day7.5_Ly108_1,Day7.5_Ly108_2_vs_Day7.5_Total_1,Day7.5_Total_2,Day7.5_Total_3 neg.'


# You need to write some codes in front of this code:
